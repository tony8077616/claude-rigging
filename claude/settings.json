{
  "env": {
    "CONTEXT_MONITOR_COST_WARNINGS": "off",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet",
    "CLAUDE_CODE_DISABLE_1M_CONTEXT": "off",
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1",
    "CLAUDE_PACKAGE_MANAGER": "bun"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": []
  },
  "model": "haiku",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${HOME:fwd}/.claude/hooks/dispatch/dispatch-state.js",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME:fwd}/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"${HOME:fwd}/.claude/calico/update.ps1\" -Mode hook",
            "timeout": 10,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/nodejs/node.exe\" \"${HOME:fwd}/.claude/hooks/context-mode-cache-heal.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${HOME:fwd}/.claude/hooks/tmp-cleanup.js",
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME:fwd}/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Program Files/nodejs/node.exe",
            "args": [
              "${HOME:fwd}/.claude/hooks/semble/block-shell-search.js"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Program Files/nodejs/node.exe",
            "args": [
              "${HOME:fwd}/.claude/hooks/semble/block-shell-search.js"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Program Files/nodejs/node.exe",
            "args": [
              "${HOME:fwd}/.claude/hooks/semble/block-grep.js"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "mcp__plugin_context-mode_context-mode__ctx_execute|mcp__plugin_context-mode_context-mode__ctx_batch",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Program Files/nodejs/node.exe",
            "args": [
              "${HOME:fwd}/.claude/hooks/semble/block-ctx-execute.js"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node ${HOME:fwd}/.claude/hooks/dispatch/dispatch-ratio.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "node ${HOME:fwd}/.claude/hooks/dispatch/dispatch-workflow.js",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME:fwd}/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME:fwd}/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME:fwd}/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME:fwd}/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME:fwd}/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME:fwd}/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME:fwd}/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME:fwd}/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME:fwd}/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME:fwd}/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME:fwd}/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME:fwd}/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "ElicitationResult": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME:fwd}/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME:fwd}/.orca/agent-hooks/orca-agent-hook.exe claude",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enableWorkflows": true,
  "workflowSizeGuideline": "unrestricted",
  "defaultShell": "powershell",
  "statusLine": {
    "type": "command",
    "command": "${HOME:fwd}/.orca/agent-hooks/claude-statusline.cmd"
  },
  "enabledPlugins": {
    "ecc@ecc": true,
    "flightdeck@claude-flightdeck": true,
    "ponytail@ponytail": true,
    "cloudflare@cloudflare": true,
    "context7@anthropic-plugin-directory": true,
    "sepia@sepia": true,
    "github@anthropic-plugin-directory": true,
    "microsoft-docs@anthropic-plugin-directory": true,
    "commit-commands@anthropic-plugin-directory": false,
    "code-modernization@anthropic-plugin-directory": true,
    "frontend-design@anthropic-plugin-directory": false,
    "claude-security@anthropic-plugin-directory": true,
    "pr-review-toolkit@anthropic-plugin-directory": false,
    "ralph-loop@anthropic-plugin-directory": false,
    "context-mode@context-mode": true,
    "browser-use@synced": false,
    "cowork-plugin-management@synced": false,
    "typescript-native-lsp@synced": false,
    "hookify@synced": false,
    "code-review@synced": false,
    "code-simplifier@synced": false,
    "commit-commands@synced": false,
    "explanatory-output-style@synced": false,
    "advisor-loop@claude-config": true
  },
  "extraKnownMarketplaces": {
    "ecc": {
      "source": {
        "source": "git",
        "url": "https://github.com/affaan-m/ECC.git"
      },
      "autoUpdate": true
    },
    "claude-flightdeck": {
      "source": {
        "source": "github",
        "repo": "scasella/claude-flightdeck"
      },
      "autoUpdate": true
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      },
      "autoUpdate": true
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      },
      "autoUpdate": true
    },
    "sepia": {
      "source": {
        "source": "github",
        "repo": "Nanako0129/sepia"
      },
      "autoUpdate": true
    },
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      },
      "autoUpdate": true
    },
    "claude-config": {
      "source": {
        "source": "directory",
        "path": "${REPO:json}"
      }
    }
  },
